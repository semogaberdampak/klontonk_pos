{
  "id": "klontonk-pos",
  "name": "Klontonk POS",
  "short_name": "Klontonk",
  "description": "Sistem Point of Sales modern untuk bisnis multi-cabang",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait-primary",
  "background_color": "#EBE4DB",
  "theme_color": "#FFFFFF",
  "lang": "id",
  "dir": "ltr",
  "categories": ["business", "productivity"],
  "display_override": ["standalone", "window-controls-overlay", "tabbed", "minimal-ui"],
  "prefer_related_applications": false,
  "related_applications": [
    { "platform": "webapp", "url": "https://semogaberdampak.github.io/klontonk_pos/manifest.json" }
  ],
  "launch_handler": { "client_mode": "navigate-existing" },
  "handle_links": "preferred",
  "edge_side_panel": { "preferred_width": 480 },
  "share_target": {
    "action": "./index.html",
    "method": "GET",
    "params": { "title": "share_title", "text": "share_text", "url": "share_url" }
  },
  "protocol_handlers": [
    { "protocol": "web+klontonk", "url": "./index.html?protocol=%s" }
  ],
  "file_handlers": [
    {
      "action": "./index.html",
      "name": "Impor stok dari CSV",
      "accept": { "text/csv": [".csv"], "application/vnd.ms-excel": [".csv"] },
      "launch_type": "single-client"
    }
  ],
  "note_taking": { "new_note_url": "./index.html?note=new" },
  "tab_strip": {
    "home_tab": "auto",
    "new_tab_button": { "url": "./index.html#/kasir" }
  },
  "widgets": [
    {
      "name": "Aksi Cepat Klontonk",
      "short_name": "Aksi Cepat",
      "description": "Buka halaman Kasir atau Stok Total langsung dari widget.",
      "tag": "klontonk-aksi-cepat",
      "template": "aksi-cepat",
      "ms_ac_template": "widgets/quick-actions.json",
      "data": "widgets/quick-actions-data.json",
      "type": "application/json",
      "screenshots": [
        { "src": "assets/screenshots/widget-quick-actions.png", "sizes": "600x300", "label": "Widget aksi cepat Klontonk POS" }
      ],
      "icons": [{ "src": "assets/icons/icon-192.png", "sizes": "192x192" }],
      "auth": false,
      "update": 86400
    }
  ],
  "screenshots": [
    {
      "src": "assets/screenshots/wide-login.png",
      "sizes": "1280x720",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Halaman masuk Klontonk POS di layar lebar"
    },
    {
      "src": "assets/screenshots/narrow-login.png",
      "sizes": "540x960",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Halaman masuk Klontonk POS di layar ponsel"
    }
  ],
  "icons": [
    {
      "src": "assets/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "assets/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "assets/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "assets/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Menu Kasir",
      "short_name": "Kasir",
      "url": "./index.html#/kasir",
      "icons": [{ "src": "assets/icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Stok Total",
      "short_name": "Stok",
      "url": "./index.html#/stok/total",
      "icons": [{ "src": "assets/icons/icon-192.png", "sizes": "192x192" }]
    }
  ]
}
